CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
# CONFIG_ESPTOOLPY_FLASHMODE_QIO is not set
# CONFIG_ESPTOOLPY_FLASHMODE_OPI is not set

CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# CONFIG_ESPTOOLPY_FLASHFREQ_120M is not set

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_ESPTOOLPY_FLASH_VENDOR_GENERIC=y
# CONFIG_ESPTOOLPY_FLASH_VENDOR_ESP is not set
# CONFIG_ESPTOOLPY_FLASH_VENDOR_WINBOND is not set
# CONFIG_ESPTOOLPY_FLASH_VENDOR_GD is not set
# CONFIG_ESPTOOLPY_FLASH_VENDOR_XMC is not set
